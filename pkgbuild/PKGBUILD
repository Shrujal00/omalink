pkgname=omalink
pkgver=0.2.0
pkgrel=1
pkgdesc='Your Android phone on your Omarchy desktop: messages, calls, notifications, files, gallery, clipboard and screen sharing'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-multimedia' 'qt6-wayland' 'bluez' 'pipewire' 'wireplumber' 'wl-clipboard')
optdepends=('qt6-webengine: RCS chats through Messages for Web')
makedepends=('gcc' 'make' 'qt6-webengine' 'qt6-multimedia')
options=('!strip' '!debug' '!lto')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/omalink "$pkgdir/usr/bin/omalink"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/omalink.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/omalink.svg"
  install -Dm644 "$startdir/omalink.desktop" "$pkgdir/usr/share/applications/omalink.desktop"
}
