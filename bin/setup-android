#!/bin/sh
# One-time setup for building the phone app: the Android SDK and NDK into
# ~/Android/Sdk (about 2 GB), and Rust's Android target. Running this accepts
# Google's Android SDK licences on your behalf; read them first with
#   ~/Android/Sdk/cmdline-tools/latest/bin/sdkmanager --licenses
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
SDK="${ANDROID_HOME:-$HOME/Android/Sdk}"
NDK_VERSION=27.2.12479018
cd "$ROOT"

if [ ! -x "$SDK/cmdline-tools/latest/bin/sdkmanager" ]; then
  mkdir -p "$SDK/cmdline-tools"
  TMP="$(mktemp -d)"
  curl -fL -o "$TMP/tools.zip" https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip
  unzip -q "$TMP/tools.zip" -d "$TMP"
  mv "$TMP/cmdline-tools" "$SDK/cmdline-tools/latest"
  rm -rf "$TMP"
fi

JAVA_HOME="$(mise where java)"; export JAVA_HOME
yes | "$SDK/cmdline-tools/latest/bin/sdkmanager" --licenses >/dev/null
"$SDK/cmdline-tools/latest/bin/sdkmanager" "platform-tools" "platforms;android-35" "build-tools;35.0.0" "ndk;$NDK_VERSION"

mise exec -- rustup target add aarch64-linux-android

echo "sdk.dir=$SDK" > "$ROOT/android/local.properties"
echo "Ready. Build the app with bin/build-android."
